# Application Settings
APP_NAME="OpenBMC Firmware Research Platform"
APP_VERSION="1.0.0"
DEBUG=False
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# Database
DATABASE_URL=sqlite:///./openbmc.db
SQLALCHEMY_ECHO=False

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
TRUST_PROXY=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Redfish BMC Configuration
BMC_HOST=192.168.1.100
BMC_PORT=443
BMC_USERNAME=root
BMC_PASSWORD=root
BMC_VERIFY_SSL=False
BMC_TIMEOUT=30
BMC_RETRIES=3
BMC_RETRY_DELAY=1

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=admin@openbmc.local

# Logging
LOG_FILE_PATH=./logs/application.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# Redis (Optional - for caching)
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Monitoring & Telemetry
ENABLE_METRICS=True
METRICS_PORT=9090

# Default Admin User
ADMIN_EMAIL=admin@openbmc.local
ADMIN_PASSWORD=OpenBMC@123!
ADMIN_FULLNAME=Administrator

# Timezone
TIMEZONE=UTC

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax